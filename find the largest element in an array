pragma solidity ^0.8.20;

contract Largest {

    function findLargest(uint[] memory arr)
        public
        pure
        returns (uint)
    {
        uint largest = arr[0];

        for (uint i = 1; i < arr.length; i++) {
            if (arr[i] > largest) {
                largest = arr[i];
            }
        }

        return largest;
    }
}
