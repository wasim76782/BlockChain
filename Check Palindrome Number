pragma solidity ^0.8.20;

contract Palindrome {

    function isPalindrome(uint n) public pure returns (bool) {

        uint original = n;
        uint rev = 0;

        while (n > 0) {
            uint digit = n % 10;
            rev = rev * 10 + digit;
            n = n / 10;
        }

        return original == rev;
    }
}
